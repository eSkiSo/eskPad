<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
        <title>EskPad</title>

        <style>
            body {
                min-height: 100vh;
                display: flex;
                flex-direction: column;
            }

            main {
                flex: 1;
            }

            .layout {
                display: flex;
                gap: 1rem;
            }

            aside {
                width: 250px;
                flex-shrink: 0;
                border-right: 1px solid var(--muted-border-color);
                padding-right: 1rem;
            }

            section {
                flex: 1;
            }

            footer {
                margin-top: auto;
            }

            /* Mobile fallback */
            @media (max-width: 768px) {
                .layout {
                    flex-direction: column;
                }

                aside {
                    width: 100%;
                    border-right: none;
                    border-bottom: 1px solid var(--muted-border-color);
                    padding-bottom: 1rem;
                }
            }
        </style>
    </head>
    <body>
        <main class="container-fluid">
            <div class="layout">
                <!-- Sidebar -->
                <aside>
                    <nav>
                        <ul>
                            <li><strong>Last Pads</strong></li>
                            {{ .last_links }}
                        </ul>
                    </nav>
                </aside>

                <!-- Main Content -->
                <section>
                    <form action="/update" method="POST">
                        <input type="text" name="url" placeholder="my-pad" aria-label="Url" value="{{ .url }}">
                        <select name="tipo" aria-label="Type of content..." required>
                            <option value="language-plaintext" selected>Plain Text</option>
                            <option value="">Code</option>
                        </select>
                        <textarea class= "texta" name="content" placeholder="" rows="20">{{ .content }}</textarea>
                        <input type="submit" value="Save" />
                    </form>
                </section>
            </div>
        </main>
    </body>
</html>