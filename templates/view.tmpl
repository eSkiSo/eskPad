<!doctype html>
<html lang="en">
  	<head>
	    <meta charset="utf-8">
	    <meta name="viewport" content="width=device-width, initial-scale=1">
	    <meta name="color-scheme" content="light dark">
	    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css">
	    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/styles/tokyo-night-dark.min.css">
	    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
	    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.11.1/highlight.min.js"></script>
	    <title>EskPad: {{ .url }}</title>

	    <style>
	        body {
	            min-height: 100vh;
	            display: flex;
	            flex-direction: column;
	        }

	        main {
	            flex: 1;
	            position: relative;
	        }

	        #buttons {
	        	position: absolute;
	        	top: 1rem;
	        	right: 1rem;
	        }

	        #buttons a {
	        	text-decoration: none;
	        	font-size: 32px;
	        }

	        .layout {
	            display: flex;
	            gap: 1rem;
	        }

	        section {
	            flex: 1;
	        }

	        footer {
	            margin-top: auto;
	        }

	        /* Mobile fallback */
	        @media (max-width: 768px) {
	            .layout {
	            	flex-direction: column;
	            }
	        }
	    </style>
  	</head>
  	<body>
    	<main class="container-fluid">
    		<div id="buttons">
    			<a href="{{ .url }}/raw" title="Raw" target="_blank" style="color: white;">
    		    	<i class="bi bi-filetype-raw"></i>
    			</a>&nbsp;
    			<a href="{{ .url }}/update" title="Update">
    		    	<i class="bi bi-pencil-square"></i>
    			</a>&nbsp;
    			<a href="{{ .url }}/delete" title="Delete" style="color: red;">
    				<i class="bi bi-trash"></i>
    			</a>
    		</div>
      		<div class="layout">
        		<!-- Main Content -->
        		<section>
      			<a href="/" style="text-decoration:none; font-size: 32px;"><i class="bi bi-arrow-left-circle-fill"></i></a>
      				<h2>{{ .title }}</h2>
        			<pre><code class="{{ .tipo }}">
{{ .content }}
          			</code></pre>
        		</section>
      		</div>
    	</main>
    	<!-- Footer pushed to bottom -->
    	<footer class="container-fluid">
      		<small>Visits: <b>{{ .visits }}</b> Updated at <b>{{ .updated_at }}</b> </small>
    	</footer>
  	</body>
  	<script>hljs.highlightAll();</script>
</html>